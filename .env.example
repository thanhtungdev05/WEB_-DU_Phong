# ============================================================
# Cấu hình Môi trường FTC Virtual Devices
# Sao chép file này thành .env và điền thông tin thực tế
# ============================================================

APP_ENV=local
APP_BASE_URL=http://localhost:8080
APP_TIMEZONE=Asia/Ho_Chi_Minh
# Giới hạn JSON cho một lần xuất XLSX (mặc định 8 MiB, tối đa 16 MiB).
API_MAX_REPORT_BODY_BYTES=8388608
# Maximum time the dispatcher waits for the internal API (seconds).
API_PROXY_TIMEOUT_SECONDS=90
# Chỉ bật khi cổng public luôn nằm sau reverse proxy đáng tin cậy (ví dụ Render).
# TRUST_UPSTREAM_PROXY=1

# Kết nối PostgreSQL (Neon Database hoặc Local Postgres)
DATABASE_URL=postgresql://<username>:<password>@<host>/<database>?sslmode=require
# /dashboard/all bat buoc co from/to, toi da 366 ngay, va phan trang cursor.
DASHBOARD_MAX_RANGE_DAYS=366
DASHBOARD_SESSION_PAGE_SIZE=500
# Tra cứu KTV dùng aggregate phân trang; lịch sử chỉ tải khi mở một KTV.
DASHBOARD_TECHNICIAN_PAGE_SIZE=25
DASHBOARD_TECHNICIAN_HISTORY_PAGE_SIZE=50
# So phien chi tiet gan nhat tren dashboard ca nhan; KPI va xu huong van tinh toan bo lich su.
PERSONAL_DASHBOARD_SESSION_LIMIT=100
# Ngan sach canh bao trong log (khong tu dong cat response).
DASHBOARD_MAX_RESPONSE_BYTES=2097152
DASHBOARD_MAX_QUERY_COUNT=8
API_MAX_RESPONSE_BYTES=8388608
API_MAX_QUERY_COUNT=20
# Catalog KTV/thiet bi/lab duoc cache rieng, khong kem theo session detail.
DASHBOARD_CATALOG_CACHE_SECONDS=21600
LEARNING_CATALOG_CACHE_SECONDS=21600
# Danh muc khu vuc/chi nhanh thay doi it, cho phep browser cache rieng.
ROSTER_REGION_CACHE_SECONDS=3600
# Cho phep portal/simulator khoi dong khi PostgreSQL/Neon tam thoi khong truy cap duoc.
# Dat 0 neu muon deploy dung ngay khi database mat ket noi.
ALLOW_START_WITHOUT_DATABASE=1
# So lan kiem tra ket noi luc khoi dong (moi lan cach nhau 5 giay).
DATABASE_STARTUP_ATTEMPTS=5

# Cấu hình Django Admin Panel
DJANGO_SETTINGS_MODULE=admin_site.settings
DJANGO_SECRET_KEY=change-me-to-a-secure-random-string-in-production
DJANGO_DEBUG=0
# DJANGO_ALLOWED_HOSTS=your-app.example.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app.example.com
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=YourStrongPasswordHere!

# Bắt buộc cho client server-to-server. Portal đăng nhập cùng origin không cần key.
# TRACKING_API_KEY=generate-a-long-random-secret
# TRACKING_MAX_DURATION_SECONDS=86400

# Ghi phiên bản triển khai vào health check (Render tự cung cấp RENDER_GIT_COMMIT).
# APP_VERSION=git-commit-or-release-tag


# (Tuỳ chọn) Cấu hình IAM SSO (nếu sử dụng FPT IAM)
# IAM_AUTH_SERVER_URL=https://iam.fpt.vn/auth
# IAM_REALM=fpt
# IAM_CLIENT_ID=your_client_id
# IAM_CLIENT_SECRET=your_client_secret
# IAM_REDIRECT_URI=http://localhost:8080/
